# Neon PostgreSQL connection string (required for database persistence & migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Fastify HTTP server port
PORT=3001
NODE_ENV=development

# Initial superadmin seed credentials (used by `npm run db:seed`)
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=admin123
